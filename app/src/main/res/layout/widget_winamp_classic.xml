<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <!-- Top LCD Section -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/widget_screen_bg"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ WINAMP"
            android:textColor="#FFCC00"
            android:textStyle="bold"
            android:textSize="11sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_track_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:text="DJ Mike Llama - Llama Whippin' Intro"
            android:textColor="#00FF44"
            android:textSize="11sp"
            android:typeface="monospace"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="192k STEREO"
            android:textColor="#00DDFF"
            android:textSize="9sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- Bottom Transport Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/widget_btn_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button_bg"
            android:text="◄◄"
            android:textColor="#E0E0FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button_bg"
            android:text="▶ / ❚❚"
            android:textColor="#00FF88"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/widget_btn_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button_bg"
            android:text="■"
            android:textColor="#FF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/widget_btn_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:text="►►"
            android:textColor="#E0E0FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>

